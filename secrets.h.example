/*
 * secrets.h.example  —— 模板 (可提交到 git)
 *
 * 用法: 复制本文件为 secrets.h, 填入你自己的真实值。
 *       secrets.h 已被 .gitignore 忽略, 不会提交, 保护你的密钥。
 */
#ifndef _SECRETS_H_
#define _SECRETS_H_

/* WiFi */
#define SECRET_WIFI_SSID     "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

/* DeepSeek API Key (形如 sk-xxxx) */
#define SECRET_DEEPSEEK_API_KEY "sk-REPLACE_WITH_YOUR_KEY"

/* Code-CLI 中转站 Session Cookie (F12 → Network → Cookie: session=...) */
#define SECRET_CODECLI_SESSION "MTc4...YOUR_SESSION_VALUE"

/* Code-CLI 用户 ID (后台响应 data.id 的值) */
#define SECRET_CODECLI_USER_ID "2061"

#endif
